# ── Configuración del Servidor ──────────────────────────────────────────────
# Puerto en el que se ejecutará el servidor Express
PORT=3000

# ── Configuración de CORS ────────────────────────────────────────────────────
# Orígenes permitidos para peticiones CORS (separados por coma)
# En desarrollo local: http://localhost:5173
# En producción: https://tu-dominio-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Configuración de Firebase Admin ──────────────────────────────────────────
# ID del proyecto de Firebase (se encuentra en la consola de Firebase)
FIREBASE_PROJECT_ID=tu-proyecto-firebase-id

# ── Variables para Firebase Admin en Producción (Render/Railway) ─────────────
# Estas variables solo son necesarias si NO usas el archivo firebase-adminsdk.json
# En desarrollo local, usa el archivo firebase-adminsdk.json en la raíz del proyecto
# En producción (Render/Railway), configura estas variables de entorno:

# Email del service account de Firebase (desde firebase-adminsdk.json)
FIREBASE_CLIENT_EMAIL=

# Private key del service account (desde firebase-adminsdk.json)
# IMPORTANTE: En producción, copia el valor completo incluyendo -----BEGIN/END-----
# y reemplaza los saltos de línea literales con \n
FIREBASE_PRIVATE_KEY=
